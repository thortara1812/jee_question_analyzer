# Paste into Streamlit Community Cloud > Advanced settings > Secrets.
# Replace this placeholder there. Never commit a real secrets.toml file.
# Frontend-only hosting: the Groq/Tavily keys belong on Render, not here.
JEE_API_URL = "https://jee-question-analyzer.onrender.com"
JEE_API_TOKEN = "replace_with_a_long_random_shared_token"
JEE_HISTORY_MODE = "session"
CREWAI_TRACING_ENABLED = "false"
OTEL_SDK_DISABLED = "true"
LITELLM_LOCAL_MODEL_COST_MAP = "true"
