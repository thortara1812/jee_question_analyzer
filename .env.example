# Keep actual credentials only in local .env
GROQ_API_KEY=replace_with_your_key
JEE_MODEL=groq/openai/gpt-oss-120b
TAVILY_API_KEY=
# max tokens 128–2000; timeout seconds 1–120; attempts 1–3
JEE_MAX_TOKENS=900
JEE_TIMEOUT=60
JEE_JOB_TIMEOUT_SECONDS=300
JEE_ATTEMPTS=3
# Seconds between stage attempts within one process, 0–60
JEE_MIN_INTERVAL=20
CREWAI_TRACING_ENABLED=false
OTEL_SDK_DISABLED=true
# session (safe for shared hosting) or local (single-user SQLite history)
JEE_HISTORY_MODE=session
# Optional split hosting: blank URL keeps the original local workflow.
# On Streamlit, set URL to https://jee-question-analyzer.onrender.com.
JEE_API_URL=
# Set the same long random token on Render and Streamlit; never commit it.
JEE_API_TOKEN=
